# Durable BUYBACK outbound worker (preferred deployment variable names)
DIGISAKA_API_BASE="https://api.example.test/api"
DIGISAKA_BRIDGE_TOKEN="replace-with-a-dedicated-scoped-sanctum-token"
# Optional. If set, it MUST be globally unique for each simultaneously running
# process/replica. Otherwise the worker derives a safe hostname:pid identity.
# OUTBOUND_WORKER_ID="digisaka-solana-host-a-01"
POLL_INTERVAL_MS=5000
BATCH_LIMIT=10
OUTBOUND_REQUEST_TIMEOUT_MS=10000
OUTBOUND_CLAIM_TTL_MS=300000
# Use dedicated persistent storage per cluster and replica; journal records are network-bound.
OUTBOUND_JOURNAL_PATH="./data/outbound-anchor-journal-devnet-replica-01.json"

# Solana: start on devnet. Keep the keypair outside this repository.
SOLANA_RPC_URL="https://api.devnet.solana.com"
SOLANA_CLUSTER="devnet"
SOLANA_KEYPAIR_PATH="C:/secure/digisaka-solana-fee-payer.json"
SOLANA_RPC_TIMEOUT_MS=10000
SOLANA_CONFIRM_TIMEOUT_MS=90000
SOLANA_SEND_MAX_RETRIES=3
SOLANA_RECONCILE_LOOKBACK=100
SOLANA_RECONCILE_TIMEOUT_MS=15000
ALLOW_SOLANA_MAINNET=false

# Optional only when the payload URI uses another explicitly trusted Laravel origin.
# LARAVEL_PAYLOAD_ORIGIN="https://api.example.test"

# Local HTTP is rejected unless explicitly enabled for local development.
ALLOW_INSECURE_LOCAL_HTTP=false

# Legacy non-BUYBACK HTTP service. BUYBACK routes are not mounted.
NODE_ENV=production
NODE_SERVICE_PORT=3000
REQUEST_BODY_LIMIT="256kb"
BRIDGE_HMAC_SECRET="replace-with-at-least-32-random-characters"
SKIP_HMAC_AUTH=false
HMAC_MAX_TIMESTAMP_AGE_MS=300000

# These must exactly match the addresses bundled in src/idl/*.json.
SOLANA_CORE_PROGRAM_ID="9EmtNU2gHnfZV3388ncLcWZgLWP8eVnM476M9tawYL4Q"
SOLANA_BUYBACK_PROGRAM_ID="DbE2kBwg3qVkqfzTyxTp4joofy9NxMhSKKZi4rh1wwu3"
SOLANA_DISTRIBUTION_PROGRAM_ID="FqMZ32zmvBAWM8LXEojZrHG4K8qTSBRvJar3YWDbrZH4"
SOLANA_TRACING_PROGRAM_ID="8reLtj3xNmEdx6o2Lc39hQdbpnqt3ouNTGdntwMmsypg"
SOLANA_CARBON_PROGRAM_ID="22bJBJb7sWEGFbKkt9AxxQP9oyiX3FcScuXKtynizzTi"

# Compatibility fallback only; prefer SOLANA_KEYPAIR_PATH.
# SOLANA_FEE_PAYER_SECRET_KEY="[64-byte JSON array]"
