        {
            "name": "settle_buyback",
            "docs": [
                "Settle a buyback agreement after harvest.",
                "",
                "C-1: authority must equal bridge_config.bridge_authority.",
                "D-3: The on-chain total is derived fully from stored fields and",
                "actual_harvest_kg.  total_price_signed must match within",
                "PRICE_TOLERANCE_CENTS (10 cents) or the instruction fails.",
                "",
                "Formula (all amounts in cents):",
                "raw_harvest  = (actual_harvest_kg * pm_market_price) / 1000",
                "premium      = (actual_harvest_kg * premium_per_kg)  / 1000",
                "expected_net = (raw_harvest + premium) - pb_borrowed_price",
                "",
                "total_price_signed > 0 → provider owes farmer",
                "total_price_signed < 0 → farmer owes provider"
            ],
            "discriminator": [250, 32, 20, 144, 221, 187, 195, 0],
            "accounts": [
                {
                    "name": "buyback",
                    "writable": true,
                    "pda": {
                        "seeds": [
